<?xml version="1.0" encoding="utf-8"?>
<!-- Inter (OFL) variable font at weight 500; android:* for the framework, app:* for AppCompat. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <font android:font="@font/inter" android:fontStyle="normal" android:fontWeight="500"
        android:fontVariationSettings="'wght' 500"
        app:font="@font/inter" app:fontStyle="normal" app:fontWeight="500"
        app:fontVariationSettings="'wght' 500" />
</font-family>
