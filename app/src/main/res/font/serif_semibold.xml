<?xml version="1.0" encoding="utf-8"?>
<!-- Playfair Display (OFL) variable font at weight 600; android:* for the framework, app:* for AppCompat. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <font android:font="@font/playfair_display" android:fontStyle="normal" android:fontWeight="600"
        android:fontVariationSettings="'wght' 600"
        app:font="@font/playfair_display" app:fontStyle="normal" app:fontWeight="600"
        app:fontVariationSettings="'wght' 600" />
</font-family>
