<?xml version="1.0" encoding="utf-8"?>
<!-- Novel, EPUB and PDF reader settings; the same values the in-reader sheet of DocumentActivity changes. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory android:title="@string/txt_teks">
        <ListPreference android:key="epub_font" android:title="@string/font" android:defaultValue="SERIF"
            android:entries="@array/text_font_names" android:entryValues="@array/text_font_values" android:summary="%s" />
        <SeekBarPreference android:key="epub_text_size" android:title="@string/txt_ukuran_teks" android:defaultValue="110"
            android:max="200" app:min="80" app:seekBarIncrement="10" app:showSeekBarValue="true" />
        <SeekBarPreference android:key="epub_line_spacing" android:title="@string/line_spacing" android:defaultValue="16"
            android:max="22" app:min="12" app:showSeekBarValue="false" />
        <SeekBarPreference android:key="epub_margin" android:title="@string/txt_margin_dp" android:defaultValue="20"
            android:max="48" app:min="0" app:seekBarIncrement="4" app:showSeekBarValue="true" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/txt_tampilan">
        <ListPreference android:key="text_reader_background" android:title="@string/txt_latar_belakang" android:defaultValue="PAPER"
            android:entries="@array/reader_background_names" android:entryValues="@array/reader_background_values" android:summary="%s" />
        <SwitchPreferenceCompat android:key="text_keep_screen_on" android:title="@string/txt_biarkan_layar_menyala" android:defaultValue="true" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/txt_pdf">
        <ListPreference android:key="pdf_mode" android:title="@string/txt_mode_pdf" android:defaultValue="SCROLL"
            android:entries="@array/pdf_mode_names" android:entryValues="@array/pdf_mode_values" android:summary="%s" />
    </PreferenceCategory>
</PreferenceScreen>
