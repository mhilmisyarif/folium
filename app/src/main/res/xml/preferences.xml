<?xml version="1.0" encoding="utf-8"?>
<!-- Grouped as in Folium spec §4.5; every entry is a working setting (no placeholders). -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="@string/txt_tampilan">
        <ListPreference android:key="app_language" android:title="@string/language" android:persistent="false"
            android:entries="@array/language_names" android:entryValues="@array/language_values" android:summary="%s" />
        <ListPreference android:key="theme" android:title="@string/txt_tema" android:defaultValue="system"
            android:entries="@array/theme_names" android:entryValues="@array/theme_values" android:summary="%s" />
        <SwitchPreferenceCompat android:key="dynamic_color" android:defaultValue="false"
            android:title="@string/dynamic_color" android:summary="@string/dynamic_color_summary" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/txt_membaca">
        <Preference android:key="reader_comic_settings" android:title="@string/reader_comic_settings"
            android:summary="@string/txt_mode_baca_skala_kontrol_layar" />
        <Preference android:key="reader_text_settings" android:title="@string/reader_text_settings"
            android:summary="@string/txt_font_ukuran_teks_spasi_margin" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/library">
        <Preference android:key="sources" android:title="@string/manga_sources" android:summary="@string/txt_urutan_kelola_katalog_nsfw_mirror" />
        <SwitchPreferenceCompat android:key="tracker_enabled" android:title="@string/txt_cek_chapter_baru_otomatis"
            android:summary="@string/txt_untuk_favorit_di_koleksi_yang" android:defaultValue="true" />
        <ListPreference android:key="tracker_interval" android:title="@string/txt_interval_cek" android:defaultValue="6"
            android:dependency="tracker_enabled" android:entries="@array/interval_names" android:entryValues="@array/interval_values" android:summary="%s" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/txt_penyimpanan">
        <Preference android:key="clear_cache" android:title="@string/txt_bersihkan_cache_gambar" />
        <Preference android:key="clear_downloads" android:title="@string/txt_hapus_semua_unduhan" />
        <Preference android:key="clear_stats" android:title="@string/txt_hapus_statistik" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/txt_sinkronisasi">
        <Preference android:key="backup" android:title="@string/txt_buat_backup" android:summary="@string/txt_favorit_koleksi_riwayat_bookmark_domain" />
        <Preference android:key="restore" android:title="@string/txt_pulihkan_backup" />
        <Preference android:key="tracking" android:title="@string/tracking" android:summary="@string/txt_anilist_myanimelist_kitsu_shikimori" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/app_name">
        <Preference android:key="about" android:title="@string/about" android:icon="@drawable/ic_folium_logo" />
    </PreferenceCategory>
</PreferenceScreen>
