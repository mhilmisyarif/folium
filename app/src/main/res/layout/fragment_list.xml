<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.tabs.TabLayout android:id="@+id/tabs" android:visibility="gone"
        android:layout_width="match_parent" android:layout_height="wrap_content" app:tabMode="scrollable" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:clipToPadding="false"
            android:layout_width="match_parent" android:layout_height="match_parent" android:padding="@dimen/space_1" />
        <TextView android:id="@+id/empty" style="@style/Widget.App.EmptyState" android:visibility="gone" android:text="@string/empty_list" />
    </FrameLayout>
</LinearLayout>
